rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: each user can read and write all documents in their own user path
    // including subcollections: fields, checkins, climateCache, and settings
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Community posts: readable by authenticated users
    match /communityPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

      // Replies subcollection
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
      }
    }

    // Community reports: create-only by authenticated users
    match /communityReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Crop catalogues: read-only for authenticated users
    match /cropCatalogues/{catalogueId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
