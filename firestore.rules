rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: each user can only read/write their own data
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Fields subcollection
      match /fields/{fieldId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Check-ins subcollection
      match /checkins/{checkinId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.fieldId is string
          && request.resource.data.fieldId.size() > 0;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Climate cache subcollection
      match /climateCache/{cacheId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Community posts: readable by authenticated users, writable with verified email
    match /communityPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.category is string
        && request.resource.data.category in ['crop_question', 'seed_availability', 'market_information']
        && (!('role' in request.resource.data))
        && (!('moderation' in request.resource.data));
      allow update: if request.auth != null
        && request.auth.uid == resource.data.authorUid
        && request.resource.data.authorUid == resource.data.authorUid
        && (!('role' in request.resource.data))
        && (!('moderation' in request.resource.data));
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;

      // Replies subcollection
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.token.email_verified == true
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && (!('role' in request.resource.data))
          && (!('moderation' in request.resource.data));
        allow update: if request.auth != null
          && request.auth.uid == resource.data.authorUid
          && (!('role' in request.resource.data))
          && (!('moderation' in request.resource.data));
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorUid;
      }
    }

    // Community reports: create-only by authenticated users
    match /communityReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }

    // Crop catalogues: read-only for authenticated users
    match /cropCatalogues/{catalogueId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
